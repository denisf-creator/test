<Window x:Class="roshade2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:roshade2"
        mc:Ignorable="d"
        Title="RoShade Setup" Height="580" Width="960"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="BgDarkBrush" Color="#0E1013"/>
        <SolidColorBrush x:Key="PanelDarkBrush" Color="#111317"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#262930"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9BA1AE"/>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F2F4F8"/>
            <Setter Property="Foreground" Value="#0E1013"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D0D5DD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#14171C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#343842"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E2229"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4E5463"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelectableCardStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#15181E"/>
            <Setter Property="Foreground" Value="#9BA1AE"/>
            <Setter Property="BorderBrush" Value="#262930"/>
            <Setter Property="Padding" Value="6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#454B59"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#222731"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9BA1AE"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#22262E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1.5" CornerRadius="10" Margin="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.6" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. ВЕРХНЯЯ ПАНЕЛЬ ОКНА -->
            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                <Grid Margin="12,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image x:Name="TitleBarLogo" Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="RoShade Setup" Foreground="{StaticResource TextPrimaryBrush}" 
                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowControlButton}" Click="MinimizeWindow_Click" Content="—"/>
                        <Button Style="{StaticResource WindowControlButton}" IsEnabled="False" Opacity="0.5" Content="▢"/>
                        <Button Style="{StaticResource WindowControlButton}" Click="CloseWindow_Click" Content="✕"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. ОСНОВНАЯ РАБОЧАЯ ОБЛАСТЬ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="560"/>
                    <!-- Размер области под картинку: 554 x 500 px -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ЛЕВАЯ КОЛОНКА: Интерактивное сравнение БЕЗ ШЕЙДЕРОВ / С ШЕЙДЕРАМИ -->
                <Border Grid.Column="0" Margin="6,6,0,6" CornerRadius="6" ClipToBounds="True" BorderBrush="#1E2026" BorderThickness="1">
                    <Grid x:Name="ComparisonContainer" Background="#090B0E" Cursor="SizeWE"
                          MouseLeftButtonDown="Comparison_MouseDown"
                          MouseMove="Comparison_MouseMove"
                          MouseLeftButtonUp="Comparison_MouseUp"
                          SizeChanged="Comparison_SizeChanged">

                        <!-- Нижний слой: С ШЕЙДЕРАМИ (Приближен так, чтобы скрыть надпись сверху) -->
                        <Image x:Name="AfterImage" Stretch="UniformToFill" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               RenderTransformOrigin="0.5, 0.78">
                            <Image.RenderTransform>
                                <ScaleTransform ScaleX="1.24" ScaleY="1.24"/>
                            </Image.RenderTransform>
                        </Image>

                        <!-- Верхний слой: БЕЗ ШЕЙДЕРОВ (Точно такое же приближение) -->
                        <Grid x:Name="BeforeLayer" ClipToBounds="True">
                            <Grid.Clip>
                                <RectangleGeometry x:Name="BeforeImageClip" Rect="0,0,277,500"/>
                            </Grid.Clip>
                            <Image x:Name="BeforeImage" Stretch="UniformToFill" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   RenderTransformOrigin="0.5, 0.78">
                                <Image.RenderTransform>
                                    <ScaleTransform ScaleX="1.24" ScaleY="1.24"/>
                                </Image.RenderTransform>
                            </Image>
                        </Grid>

                        <!-- Плашки-подсказки -->
                        <Border Background="#B20E1013" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" IsHitTestVisible="False">
                            <TextBlock Text="WITHOUT SHADERS" Foreground="#D0D5DD" FontSize="10" FontWeight="Bold"/>
                        </Border>
                        <Border Background="#B20E1013" CornerRadius="4" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" IsHitTestVisible="False">
                            <TextBlock Text="WITH ROSHADE" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold"/>
                        </Border>

                        <!-- Линия ползунка и круглая ручка -->
                        <Canvas IsHitTestVisible="False">
                            <Grid x:Name="SliderHandle" Width="40" Height="500" Canvas.Left="257" Canvas.Top="0">
                                <Rectangle Width="2" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                                    <Rectangle.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="Black" Opacity="0.8"/>
                                    </Rectangle.Effect>
                                </Rectangle>

                                <Border Width="34" Height="34" CornerRadius="17" Background="#0E1013" BorderBrush="White" BorderThickness="2"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Color="Black" Opacity="0.7"/>
                                    </Border.Effect>

                                    <Grid Width="18" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M 4,0 L 0,5 L 4,10" Stroke="White" StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <Path Data="M 0,0 L 4,5 L 0,10" Stroke="White" StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Canvas>
                    </Grid>
                </Border>

                <!-- ПРАВАЯ КОЛОНКА: Панель управления -->
                <Border Grid.Column="1" Background="{StaticResource PanelDarkBrush}" Margin="6" CornerRadius="6" Padding="32,22,32,16">
                    <Grid>
                        <!-- ВЕРХНИЙ БЛОК: Логотип и Заголовок -->
                        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Image x:Name="MainLogo" Width="86" Height="86" Margin="0,0,0,10" RenderOptions.BitmapScalingMode="HighQuality"/>

                            <TextBlock Text="RoShade" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="A refined visual upgrade for your game." Foreground="{StaticResource TextSecondaryBrush}" 
                                       FontSize="12.5" HorizontalAlignment="Center" Margin="0,6,0,18"/>

                            <Border Height="1" Width="280" Background="{StaticResource BorderBrush}"/>
                        </StackPanel>

                        <!-- ЦЕНТРАЛЬНЫЙ БЛОК: 4 этапа -->
                        <Grid Margin="0,190,0,32">

                            <!-- ЭТАП 1 -->
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Button Style="{StaticResource PrimaryButtonStyle}" 
                                        Command="{Binding GoToStepCommand}" CommandParameter="2" Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M7,0 V9 M3,6 L7,10 L11,6 M0,13 H14" Stroke="#0E1013" StrokeThickness="1.8" 
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="I N S T A L L" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SecondaryButtonStyle}" 
                                        Command="{Binding UninstallCommand}">
                                    <TextBlock Text="U N I N S T A L L"/>
                                </Button>
                            </StackPanel>

                            <!-- ЭТАП 2 -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Text="STEP 1 OF 3 — OVERLAY KEYBIND" Foreground="{StaticResource TextSecondaryBrush}" 
                                               FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Select key to open/close RoShade panel in Roblox:" Foreground="White" 
                                               FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,18"/>

                                    <UniformGrid Columns="2" Height="64" Margin="0,0,0,20">
                                        <ToggleButton Style="{StaticResource SelectableCardStyle}" Margin="0,0,6,0"
                                                      IsChecked="{Binding IsF8Selected}">
                                            <StackPanel>
                                                <TextBlock Text="F8" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Default Key" FontSize="10" Opacity="0.7" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </ToggleButton>

                                        <ToggleButton Style="{StaticResource SelectableCardStyle}" Margin="6,0,0,0"
                                                      IsChecked="{Binding IsEndSelected}">
                                            <StackPanel>
                                                <TextBlock Text="End" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Alternative" FontSize="10" Opacity="0.7" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </ToggleButton>
                                    </UniformGrid>
                                </StackPanel>

                                <Grid VerticalAlignment="Bottom">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}" Content="BACK"
                                            Command="{Binding GoToStepCommand}" CommandParameter="1" Margin="0,0,10,0"/>
                                    <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Content="NEXT — PRESETS"
                                            Command="{Binding GoToStepCommand}" CommandParameter="3"/>
                                </Grid>
                            </Grid>

                            <!-- ЭТАП 3 -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Text="STEP 2 OF 3 — SELECT SHADER PRESETS" Foreground="{StaticResource TextSecondaryBrush}" 
                                               FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                                    <!-- 1 СТРОКА: Glossy (Glossy, Very Glossy) -->
                                    <TextBlock Text="Glossy Presets" Foreground="White" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding GlossyPresets}" Margin="0,0,0,10">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ToggleButton Style="{StaticResource SelectableCardStyle}" 
                                                              IsChecked="{Binding IsSelected}" Margin="3" Height="36">
                                                    <TextBlock Text="{Binding Name}" FontSize="11.5"/>
                                                </ToggleButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 2 СТРОКА: RoShade (RoShade Low, RoShade Medium, RoShade High) -->
                                    <TextBlock Text="RoShade Presets" Foreground="White" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding RoShadePresets}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ToggleButton Style="{StaticResource SelectableCardStyle}" 
                                                              IsChecked="{Binding IsSelected}" Margin="2.5" Height="36" Padding="3,4">
                                                    <!-- Viewbox аккуратно умещает текст в 1 строку без обрезки -->
                                                    <Viewbox StretchDirection="DownOnly">
                                                        <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center"/>
                                                    </Viewbox>
                                                </ToggleButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Grid VerticalAlignment="Bottom">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}" Content="BACK"
                                            Command="{Binding GoToStepCommand}" CommandParameter="2" Margin="0,0,10,0"/>
                                    <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Content="CONTINUE"
                                            Command="{Binding GoToStepCommand}" CommandParameter="4"/>
                                </Grid>
                            </Grid>

                            <!-- ЭТАП 4 -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Text="STEP 3 OF 3 — INSTALLATION" Foreground="{StaticResource TextSecondaryBrush}" 
                                               FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                                    <Border Background="#15181E" BorderBrush="#262930" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5">
                                                <Run Text="Toggle Keybind: "/>
                                                <Run Text="{Binding SelectedKeybind}" Foreground="White" FontWeight="Bold"/>
                                            </TextBlock>
                                            <TextBlock Text="Selected presets will be installed to Roblox." 
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="{Binding InstallStatusText}" Foreground="White" FontSize="12" 
                                               HorizontalAlignment="Center" Margin="0,0,0,8"/>

                                    <ProgressBar Value="{Binding InstallProgress}" Maximum="100" Height="10" 
                                                 Background="#1A1D24" Foreground="#FFFFFF" BorderThickness="0"/>
                                </StackPanel>

                                <Grid VerticalAlignment="Bottom">
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInstallCompleted}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}" Content="BACK"
                                                Command="{Binding GoToStepCommand}" CommandParameter="3" Margin="0,0,10,0"/>
                                        <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" 
                                                Command="{Binding StartInstallCommand}" Content="INSTALL NOW"/>
                                    </Grid>

                                    <Button Content="FINISH &amp; EXIT" Command="{Binding FinishCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInstallCompleted}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Grid>

                        </Grid>

                        <!-- НИЖНЯЯ НАДПИСЬ -->
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="11" Foreground="#6C727F">
                            <Run Text="The only official RoShade website is "/>
                            <Run Text="roshade.co" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>